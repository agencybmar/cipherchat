{
  "rules": {
    ".read": false,
    ".write": false,
    "reserved": {
      "$code": {
        ".read": true,
        ".write": "auth != null && auth.token.email == $code + '@cipherchat.invalid'",
        ".validate": "$code.matches(/^\\d{4}$/) && newData.val() == true"
      }
    },
    "users": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == $code + '@cipherchat.invalid'",
        ".validate": "$code.matches(/^\\d{4}$/)"
      }
    },
    "presence": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == $code + '@cipherchat.invalid'"
      }
    },
    "sessions": {
      "$code": {
        ".read": "auth != null && auth.token.email == $code + '@cipherchat.invalid'",
        ".write": "auth != null && auth.token.email == $code + '@cipherchat.invalid'"
      }
    },
    "conversations": {
      "$a": {
        "$b": {
          ".read": "auth != null && (auth.token.email == $a + '@cipherchat.invalid' || auth.token.email == $b + '@cipherchat.invalid')",
          ".write": "auth != null && (auth.token.email == $a + '@cipherchat.invalid' || auth.token.email == $b + '@cipherchat.invalid')",
          "$id": {
            ".validate": "!newData.exists() || (newData.hasChildren(['id','from','to','ts','iv','ciphertext','version']) && newData.child('id').val() == $id && ((newData.child('from').val() == $a && newData.child('to').val() == $b) || (newData.child('from').val() == $b && newData.child('to').val() == $a)) && newData.child('version').val() == 1)"
          }
        }
      }
    },
    "inbox": {
      "$to": {
        ".read": "auth != null && auth.token.email == $to + '@cipherchat.invalid'",
        "$id": {
          ".write": "auth != null && ((!newData.exists() && auth.token.email == $to + '@cipherchat.invalid') || (newData.exists() && newData.child('to').val() == $to && auth.token.email == newData.child('from').val() + '@cipherchat.invalid'))",
          ".validate": "!newData.exists() || (newData.child('id').val() == $id && newData.child('version').val() == 1)"
        }
      }
    },
    "events": {
      "$to": {
        ".read": "auth != null && auth.token.email == $to + '@cipherchat.invalid'",
        "$event": {
          ".write": "auth != null && ((!newData.exists() && auth.token.email == $to + '@cipherchat.invalid') || (newData.exists() && newData.child('from').isString() && auth.token.email == newData.child('from').val() + '@cipherchat.invalid'))",
          ".validate": "!newData.exists() || (newData.hasChildren(['from','type','payload','ts']) && newData.child('from').val() != $to)"
        }
      }
    }
  }
}
